rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Private student workspace. Only its owner can access it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public community snapshots are readable by everyone.
    match /publicResearch/{researchId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /universities/{universityId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
